{
  "name": "dsh-mcp-skill-manager",
  "version": "0.2.2",
  "description": "DeepSeek Harness plugin for MCP configuration and runtime skill management",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": ["@deepseek-ai/dsh-client-connection", "@deepseek-ai/dsh-client-ui-settings"],
      "platform": "web",
      "external": []
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gtk96/dsh-mcp-skill-manager.git"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4"
  }
}
