{
  "name": "dsh-mcp-skill-manager",
  "version": "0.9.0",
  "description": "DeepSeek Harness plugin for managing MCP servers and runtime skills",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "license": "MIT",
  "files": [
    "index.js",
    "discovery.js",
    "compatibility.js",
    "mcp-config.js",
    "mcp-patch.js",
    "mcp-write.js",
    "tool-guards.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web",
      "external": []
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gtk96/dsh-mcp-skill-manager.git"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "^0.2.0-rc.2 || ^0.2.1-rc.2",
    "@deepseek-ai/dsh-mcp-client": "^0.2.0-rc.2 || ^0.2.1-rc.2",
    "@deepseek-ai/dsh-atomic-write": "^0.2.0-rc.2 || ^0.2.1-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    },
    "@deepseek-ai/dsh-mcp-client": {
      "optional": true
    },
    "@deepseek-ai/dsh-atomic-write": {
      "optional": true
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4",
    "yaml": "^2.9.0"
  }
}
